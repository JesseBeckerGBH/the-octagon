# Copy to .env and fill in real values. Never commit the real .env file.

APP_ENV=development
LOG_LEVEL=INFO
PORT=8080

# Database
DUCKDB_PATH=data/processed/octagon.duckdb

# Odds / sharp-money data
ODDS_API_KEY=
SPORTSDATA_IO_API_KEY=

# Billing (only needed if this service takes payments directly;
# usually lives in ufc-predictions-saas instead)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS
CORS_ORIGINS=http://localhost:3000
